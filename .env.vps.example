# ==================================================
# YouTube Automation Agent — Oracle Free VPS
# ==================================================

# Server (required for remote access)
HOST=0.0.0.0
PORT=3456
API_KEY=change-this-to-a-long-random-secret

# Environment
NODE_ENV=production
LOG_LEVEL=info

# --------------------------------------------------
# AI Providers (add at least one)
# --------------------------------------------------
# GEMINI_API_KEY=your-gemini-key
# OPENAI_API_KEY=your-openai-key
# OPENROUTER_API_KEY=your-openrouter-key
# DEEPSEEK_API_KEY=your-deepseek-key

# Optional TTS
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Optional AI Video (recommended on free VPS)
# VIDEO_PROVIDER=slideshow
# VIDEO_PROVIDER_ORDER=kling,wan,slideshow
# KLING_ACCESS_KEY=
# KLING_SECRET_KEY=
# DASHSCOPE_API_KEY=

# --------------------------------------------------
# Channel
# --------------------------------------------------
CHANNEL_NAME=My Channel
DEFAULT_AUTHOR=Your Name
TARGET_AUDIENCE=Your audience

YOUTUBE_REGION=US
DEFAULT_PRIVACY_STATUS=private
